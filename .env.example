# Copy to .env (gitignored) or place in ~/.copilotd/.env.
#
# When DEEPSEEK_API_KEY is set, copilotd launches Copilot with DeepSeek BYOK
# (Anthropic-compatible endpoint). When it is absent, copilotd uses the
# GitHub-hosted Kitka-Games/DeepSeek/deepseek-flash catalog model instead.

# Direct DeepSeek API key (starts with sk-).
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Optional provider overrides (environment wins over config.json).
# COPILOTD_PROVIDER_MODEL=deepseek-v4-pro
# COPILOTD_PROVIDER_BASE_URL=https://api.deepseek.com/anthropic
# COPILOTD_PROVIDER_TYPE=anthropic

# Optional agent pool overrides.
# COPILOTD_AGENT_COUNT=3
# COPILOTD_AGENT_MODEL=Kitka-Games/DeepSeek/deepseek-flash
# COPILOTD_AGENT_NAME_FORMAT=(copilotd agent $(agent_index)) $(host)
# COPILOTD_ENABLE_AGENTS=true

# Docker Compose: host paths.
# COPILOTD_HOST_REPO_HOME=/home/me/repos
# COPILOT_HOME_DIR=/home/me/.copilot
# GH_CONFIG_DIR=/home/me/.config/gh
# GH_TOKEN=ghp_...
